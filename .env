# Development .env (generated automatically by assistant)
# Safe development defaults. Replace secrets for any shared or production use.
NODE_ENV=development
PORT=3000
TEST_MODE=true

# Database (development via local Postgres container defined in docker-compose.yml)
# Password for docker-compose Postgres default is 'changeme' — override via POSTGRES_PASSWORD env or set here.
DATABASE_URL=postgresql://aurapost:changeme@localhost:5432/aurapost
SQL_HOST=localhost
SQL_USER=aurapost
SQL_PASSWORD=changeme
SQL_DB_NAME=aurapost

# Pool tuning (sane dev defaults)
PG_POOL_MAX=5
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONN_TIMEOUT_MS=5000
PG_SSL=false

# Auth / Security (development random secrets)
JWT_SECRET=dev_jwt_secret_$(date +%s)
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_$(date +%s)
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ENCRYPTION_MASTER_KEY=dev_encryption_master_key_0123456789abcdef

# App URLs
APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Payment & external integrations (left empty for dev)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI Providers (left blank in dev unless you have keys)
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Image/Video providers
STABILITY_API_KEY=
FLUX_API_KEY=
VEO_API_KEY=
RUNWAY_API_KEY=

# Shopify / Social
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
META_APP_ID=
META_APP_SECRET=
FB_LOGIN_CONFIG_ID=

# Observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=debug
