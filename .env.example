# =============================================================================
# AuraPost AI — Environment Variables Template
# Copy this file to .env locally. Never commit the resulting .env file.
# =============================================================================

# ---- APPLICATION CORE ----
NODE_ENV=development
AURAPOST_RELEASE_VERSION=v1
PORT=3000
# Development/test only. Production must keep this false.
TEST_MODE=false

# V1 feature gates — all must remain false until publishing licenses are approved.
SOCIAL_CONNECTIONS_ENABLED=false
PUBLISHING_ENABLED=false
SMART_REPOST_ENABLED=false
PAID_ADS_ENABLED=false

# ---- DATABASE CONFIGURATION ----
DATABASE_URL="postgresql://aurapost:replace-with-a-strong-password@localhost:5432/aurapost"
SQL_HOST="localhost"
SQL_USER="aurapost"
SQL_PASSWORD=""
SQL_DB_NAME="aurapost"
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
PG_POOL_MAX=10
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONN_TIMEOUT_MS=5000
PG_SSL=false

# ---- AUTHENTICATION AND SECURITY ----
# Both JWT secrets are mandatory, distinct, and at least 32 characters.
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# AES-256-GCM key used to protect integration tokens stored in the database.
ENCRYPTION_MASTER_KEY=""

# ---- PUBLIC URLS AND CORS ----
# Production must set explicit public HTTPS URLs.
APP_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"
# Comma-separated cross-origin browser clients. Empty means same-origin only.
ALLOWED_ORIGINS=""

# ---- PAYMENT INTEGRATIONS ----
# Even in sandbox, real PayPal sandbox credentials are required.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_STARTER_MONTHLY_PRICE_ID=""
STRIPE_STARTER_YEARLY_PRICE_ID=""
STRIPE_PRO_MONTHLY_PRICE_ID=""
STRIPE_PRO_YEARLY_PRICE_ID=""
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=""
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=""

# ---- AI PROVIDERS & LLMS ----
GEMINI_API_KEY=""
GEMINI_IMAGES_API_KEY=""
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=""
OPENAI_IMAGES_API_KEY=""
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL=deepseek-chat
CLAUDE_API_KEY=""

# ---- IMAGE GENERATION PROVIDERS ----
STABILITY_API_KEY=""
FLUX_API_KEY=""

# ---- VIDEO GENERATION PROVIDERS ----
VEO_API_KEY=""
RUNWAY_API_KEY=""
KLING_ACCESS_KEY=""
KLING_SECRET_KEY=""
PIKA_API_KEY=""
VIDEO_PROVIDER_LIVE=false

# ---- SHOPIFY ----
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_SYNC_TEST_MODE=false

# ---- SOCIAL INTEGRATIONS (V2; disabled in V1) ----
META_APP_ID=""
META_APP_SECRET=""
FB_LOGIN_CONFIG_ID=""
SOCIAL_PUBLISH_LIVE=false

# ---- EXTRACTION & DIAGNOSTICS ----
AURAPOST_ENABLE_TEST_DATASET=false

# ---- OBSERVABILITY ----
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=info
