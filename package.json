{
  "name": "aurapost-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fix-framer-motion.cjs",
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.mjs",
    "test:api": "node --import tsx --test --test-concurrency=1 tests/auth.test.ts tests/api.test.ts tests/security.test.ts",
    "test:migrations": "node --import tsx --test --test-concurrency=1 tests/integration/aura-migrations.pg.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1094.0",
    "@aws-sdk/s3-request-presigner": "^3.1094.0",
    "@azure/storage-blob": "^12.33.0",
    "@google-cloud/storage": "^7.21.0",
    "@google/genai": "latest",
    "@sentry/node": "^10.64.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "framer-motion": "^11.18.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.400.0",
    "motion": "^11.18.2",
    "multer": "^1.4.4",
    "openai": "^6.42.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.12.7",
    "sharp": "^0.33.5",
    "stripe": "^18.5.0",
    "uuid": "^10.0.0",
    "zod": "^4.4.3",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.9",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.21.5",
    "jest": "^29.7.0",
    "sql.js": "^1.10.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.15.6",
    "typescript": "^5.9.3",
    "vite": "^5.3.1"
  }
}
